{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "experimentalDecorators": true,
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@fixture/feature-lib": ["libs/feature-lib/src/index.ts"],
      "@fixture/feature-lib/contracts": [
        "libs/feature-lib/src/contracts.ts"
      ],
      "@fixture/feature-lib/forms": ["libs/feature-lib/src/forms.ts"],
      "@fixture/formly-kit": ["libs/formly-kit/src/index.ts"],
      "@fixture/forms-kit": ["libs/forms-kit/src/index.ts"],
      "@fixture/forms-kit/contracts": ["libs/forms-kit/src/contracts.ts"],
      "@fixture/forms-kit/forms": ["libs/forms-kit/src/forms.ts"],
      "@formly-contract/schema": [
        "../../packages/schema/src/index.ts"
      ],
      "@formly-contract/schema/field-type-authoring": [
        "../../packages/schema/src/field-type-authoring.ts"
      ],
      "@formly-contract/compiler": [
        "../../packages/compiler/src/index.ts"
      ],
      "@formly-contract/workspace": [
        "../../packages/workspace/src/index.ts"
      ]
    },
    "types": ["node", "vitest/globals"]
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictTemplates": true
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "*.ts"]
}
