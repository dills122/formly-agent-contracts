{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@formly-contract/workspace": ["../workspace/dist/index.d.ts"],
      "@formly-contract/workspace/runtime-host": [
        "../workspace/dist/runtime-host/index.d.ts"
      ]
    },
    "rootDir": "src",
    "types": ["node"]
  },
  "exclude": ["src/**/*.test.ts"]
}
