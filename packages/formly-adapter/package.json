  "scripts": {
    "build": "pnpm typecheck && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@formly-agent-contracts/contract-schema": "workspace:*"
  },
  "peerDependencies": {
    "@ngx-formly/core": "6.1.8"
  },
  "devDependencies": {
    "@ngx-formly/core": "6.1.8"
  }
}
