{
  "name": "@formly-agent-contracts/formly-adapter",
  "version": "0.3.0",
  "description": "Allowlisted Formly configuration extraction for Formly Agent Contracts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
