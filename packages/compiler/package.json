{
  "name": "@formly-contract/compiler",
  "version": "0.5.0",
  "description": "Allowlisted Formly configuration extraction for Formly Contract.",
  "author": "Dylan Steele <dylansteele57@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dills122/formly-contract#readme",
  "bugs": {
    "url": "https://github.com/dills122/formly-contract/issues"
  },
  "keywords": [
    "angular",
    "formly",
    "contract",
    "e2e",
    "playwright",
    "testing",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dills122/formly-contract.git",
    "directory": "packages/compiler"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm typecheck && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@formly-contract/schema": "workspace:*"
  },
  "peerDependencies": {
    "@ngx-formly/core": ">=6.0.0 <7.0.0"
  },
  "devDependencies": {
    "@ngx-formly/core": "6.1.8"
  }
}
