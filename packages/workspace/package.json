{
  "name": "@formly-contract/workspace",
  "version": "0.1.0",
  "description": "Deterministic Formly Contract workspace discovery, generation, and CLI tooling.",
  "author": "Dylan Steele <dylansteele57@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dills122/formly-contract#readme",
  "bugs": {
    "url": "https://github.com/dills122/formly-contract/issues"
  },
  "keywords": [
    "angular",
    "formly",
    "contract",
    "workspace",
    "e2e",
    "testing",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dills122/formly-contract.git",
    "directory": "packages/workspace"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "formly-contracts": "./dist/cli-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime-host": {
      "types": "./dist/runtime-host/index.d.ts",
      "default": "./dist/runtime-host/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm typecheck && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@formly-contract/compiler": "workspace:*",
    "@formly-contract/schema": "workspace:*",
    "get-tsconfig": "4.14.0",
    "jiti": "2.7.0",
    "picomatch": "4.0.7",
    "tinyglobby": "0.2.17",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/picomatch": "4.0.3"
  }
}
