---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: 'The requested Formly Contract documentation page does not exist.',
    template: 'splash',
    hero: {
      title: 'No contract for this route.',
      tagline:
        'The page may have moved, or the capability may still be planned rather than documented.',
      actions: [
        {
          text: 'Open the documentation index',
          link: '/',
          icon: 'right-arrow',
          variant: 'primary',
        },
        {
          text: 'Search current capabilities',
          link: '/start/product-status/',
          variant: 'minimal',
        },
      ],
    },
  }}
/>
